# ==============================================================================
# SecOps Weekly Operations & Reporting Agent Configuration (Vertex AI + Cloud Run MCP)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud & Vertex AI Platform Settings
# ------------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=<YOUR_PROJECT_ID>
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
SECOPS_AGENT_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Google Security Operations (Chronicle SecOps) MCP Server (Cloud Run)
# Specify either the full MCP URL or the Cloud Run service name.
# ------------------------------------------------------------------------------
SECOPS_URL=https://<YOUR_SECOPS_SERVICE_URL>/mcp
# SECOPS_SERVICE_NAME=<YOUR_SECOPS_SERVICE_NAME>
# SECOPS_AUTH_TOKEN=
# SECOPS_TOOL_PREFIX=secops_

# ------------------------------------------------------------------------------
# 3. Google Threat Intelligence (GTI) MCP Server (Cloud Run)
# Specify either the full MCP URL or the Cloud Run service name.
# ------------------------------------------------------------------------------
GTI_URL=https://<YOUR_GTI_SERVICE_URL>/mcp
# GTI_SERVICE_NAME=<YOUR_GTI_SERVICE_NAME>
# GTI_AUTH_TOKEN=
# GTI_TOOL_PREFIX=gti_

# ------------------------------------------------------------------------------
# 4. Agent Identity & Runtime Options (Optional)
# ------------------------------------------------------------------------------
# AGENT_NAME=reporting_agent
# AGENT_APP_NAME=secops_reporting
# AGENT_SESSION_ID=secops_reporting_session_001
# AGENT_USER_ID=soc_lead
# HOST=0.0.0.0
# PORT=8080

# ------------------------------------------------------------------------------
# 5. Telemetry & Observability
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
